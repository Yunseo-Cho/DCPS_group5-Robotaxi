<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Autonomous Electric Robotaxi - UPPAAL model
// Based on SysML IBD + State Machine structure

// Channels from IBD
chan userCommand;
chan statusInfo;
chan sensorData;
chan mapUpdate;
chan telemetryData;
chan brakeCmd;
chan steeringCmd;
chan powerRequest;

// Internal control/event channels
chan onRampEntered;
broadcast chan collisionImminent;
chan hazardCleared;
chan safeGapFound;
chan noSafeGap;
chan acceptableGapFound;
chan nextBestGapFound;
chan planReady;
chan gapClosedBelowThreshold;
broadcast chan mergeCompleted;

// Shared variables
bool objectDetected = false;
bool safeGap = false;
bool planComputed = false;
bool mergeDone = false;
bool emergencyActive = false;

int remainingLane = 200;
int gapSeconds = 0;

// Timing constants
const int SENSOR_PERIOD = 2;
const int GAP_EVAL_TIME = 10;
const int MIN_SAFE_GAP = 4;
const int CRITICAL_LANE = 50;
const int BRAKE_TIME = 3;
const int PLAN_TIME = 5;
const int MERGE_TIME = 8;
</declaration>
	<template>
		<name>AI_Controller</name>
		<declaration>clock x;</declaration>
		<location id="id0" x="-935" y="-85">
			<name x="-945" y="-115">Idle</name>
		</location>
		<location id="id1" x="-680" y="-85">
			<name x="-725" y="-115">Monitoring</name>
		</location>
		<location id="id2" x="-425" y="-85">
			<name x="-475" y="-115">GapEvaluation</name>
			<label kind="invariant" x="-475" y="-65">x &lt;= GAP_EVAL_TIME</label>
		</location>
		<location id="id3" x="-425" y="170">
			<name x="-470" y="140">GapRequest</name>
		</location>
		<location id="id4" x="-170" y="-85">
			<name x="-220" y="-115">MergePlanning</name>
			<label kind="invariant" x="-220" y="-65">x &lt;= PLAN_TIME</label>
		</location>
		<location id="id5" x="85" y="-85">
			<name x="35" y="-115">MergeExecution</name>
			<label kind="invariant" x="35" y="-65">x &lt;= MERGE_TIME</label>
		</location>
		<location id="id6" x="340" y="-85">
			<name x="295" y="-115">MergeSuccess</name>
		</location>
		<location id="id7" x="-425" y="-340">
			<name x="-495" y="-370">EmergencyBraking</name>
			<label kind="invariant" x="-495" y="-320">x &lt;= BRAKE_TIME</label>
		</location>
		<location id="id8" x="85" y="170">
			<name x="45" y="140">AbortReplan</name>
		</location>
		<init ref="id0"/>
		<transition id="id9">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="-850" y="-105">onRampEntered?</label>
			<label kind="assignment" x="-850" y="-85">x = 0</label>
		</transition>
		<transition id="id10">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="synchronisation" x="-600" y="-105">sensorData?</label>
			<label kind="assignment" x="-600" y="-85">x = 0</label>
		</transition>
		<transition id="id11">
			<source ref="id2"/>
			<target ref="id4"/>
			<label kind="synchronisation" x="-345" y="-105">safeGapFound?</label>
			<label kind="assignment" x="-345" y="-85">x = 0</label>
		</transition>
		<transition id="id12">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="guard" x="-580" y="35">!safeGap &amp;&amp; remainingLane &gt; CRITICAL_LANE</label>
			<label kind="synchronisation" x="-580" y="55">noSafeGap?</label>
		</transition>
		<transition id="id13">
			<source ref="id3"/>
			<target ref="id4"/>
			<label kind="synchronisation" x="-340" y="155">safeGapFound?</label>
			<label kind="assignment" x="-340" y="175">x = 0</label>
		</transition>
		<transition id="id14">
			<source ref="id4"/>
			<target ref="id5"/>
			<label kind="guard" x="-90" y="-125">x &gt;= 1</label>
			<label kind="synchronisation" x="-90" y="-105">planReady!</label>
			<label kind="assignment" x="-90" y="-85">planComputed = true, x = 0</label>
		</transition>
		<transition id="id15">
			<source ref="id5"/>
			<target ref="id6"/>
			<label kind="guard" x="170" y="-125">x &gt;= 2</label>
			<label kind="synchronisation" x="170" y="-105">mergeCompleted!</label>
			<label kind="assignment" x="170" y="-85">mergeDone = true</label>
		</transition>
		<transition id="id16">
			<source ref="id5"/>
			<target ref="id8"/>
			<label kind="synchronisation" x="80" y="35">gapClosedBelowThreshold?</label>
			<label kind="assignment" x="80" y="55">planComputed = false</label>
		</transition>
		<transition id="id17">
			<source ref="id8"/>
			<target ref="id4"/>
			<label kind="synchronisation" x="-65" y="155">nextBestGapFound?</label>
			<label kind="assignment" x="-65" y="175">x = 0</label>
		</transition>
		<transition id="id18">
			<source ref="id1"/>
			<target ref="id7"/>
			<label kind="synchronisation" x="-620" y="-245">collisionImminent?</label>
			<label kind="assignment" x="-620" y="-225">emergencyActive = true, x = 0</label>
		</transition>
		<transition id="id19">
			<source ref="id2"/>
			<target ref="id7"/>
			<label kind="synchronisation" x="-430" y="-245">collisionImminent?</label>
			<label kind="assignment" x="-430" y="-225">emergencyActive = true, x = 0</label>
		</transition>
		<transition id="id20">
			<source ref="id4"/>
			<target ref="id7"/>
			<label kind="synchronisation" x="-260" y="-245">collisionImminent?</label>
			<label kind="assignment" x="-260" y="-225">emergencyActive = true, x = 0</label>
		</transition>
		<transition id="id21">
			<source ref="id5"/>
			<target ref="id7"/>
			<label kind="synchronisation" x="-40" y="-245">collisionImminent?</label>
			<label kind="assignment" x="-40" y="-225">emergencyActive = true, x = 0</label>
		</transition>
		<transition id="id22">
			<source ref="id7"/>
			<target ref="id1"/>
			<label kind="guard" x="-585" y="-360">x &gt;= BRAKE_TIME</label>
			<label kind="synchronisation" x="-585" y="-340">hazardCleared?</label>
			<label kind="assignment" x="-585" y="-320">emergencyActive = false, x = 0</label>
		</transition>
		<transition id="id23">
			<source ref="id6"/>
			<target ref="id6"/>
			<nail x="310" y="-115"/>
			<nail x="370" y="-115"/>
		</transition>
		<transition id="id24">
			<source ref="id3"/>
			<target ref="id4"/>
			<label kind="synchronisation" x="-500" y="210">nextBestGapFound?</label>
			<label kind="assignment" x="-500" y="230">x = 0</label>
		</transition>
		<transition id="id25">
			<source ref="id8"/>
			<target ref="id4"/>
			<label kind="synchronisation" x="170" y="210">safeGapFound?</label>
			<label kind="assignment" x="170" y="230">x = 0</label>
		</transition>
	</template>
	<template>
		<name>Sensors</name>
		<declaration>clock s;</declaration>
		<location id="id26" x="-255" y="0">
			<name x="-285" y="-30">Sense</name>
			<label kind="invariant" x="-285" y="20">s &lt;= SENSOR_PERIOD</label>
		</location>
		<location id="id27" x="0" y="0">
			<name x="-35" y="-30">SendData</name>
		</location>
		<init ref="id26"/>
		<transition id="id28">
			<source ref="id26"/>
			<target ref="id27"/>
			<label kind="guard" x="-185" y="-40">s &gt;= SENSOR_PERIOD</label>
			<label kind="assignment" x="-185" y="-20">objectDetected = true</label>
		</transition>
		<transition id="id29">
			<source ref="id27"/>
			<target ref="id26"/>
			<label kind="synchronisation" x="-145" y="35">sensorData!</label>
			<label kind="assignment" x="-145" y="55">s = 0</label>
		</transition>
		<transition id="id30">
			<source ref="id26"/>
			<target ref="id26"/>
			<label kind="guard" x="-360" y="80">objectDetected &amp;&amp; remainingLane &lt;= CRITICAL_LANE</label>
			<label kind="synchronisation" x="-360" y="100">collisionImminent!</label>
			<nail x="-285" y="-30"/>
			<nail x="-225" y="-30"/>
		</transition>
	</template>
	<template>
		<name>Environment</name>
		<declaration>clock e;</declaration>
		<location id="id31" x="-255" y="0">
			<name x="-285" y="-30">BeforeRamp</name>
		</location>
		<location id="id32" x="0" y="0">
			<name x="-45" y="-30">OnRamp</name>
		</location>
		<location id="id33" x="255" y="-85">
			<name x="215" y="-115">GapOpen</name>
		</location>
		<location id="id34" x="255" y="170">
			<name x="210" y="140">GapClosed</name>
			<label kind="invariant" x="210" y="160">e &lt;= 5</label>
		</location>
		<init ref="id31"/>
		<transition id="id35">
			<source ref="id32"/>
			<target ref="id34"/>
			<label kind="guard" x="18" y="51">e &lt; 3</label>
			<label kind="synchronisation" x="18" y="68">noSafeGap!</label>
			<label kind="assignment" x="18" y="85">safeGap = false, 
gapSeconds = 1</label>
		</transition>
		<transition id="id36">
			<source ref="id31"/>
			<target ref="id32"/>
			<label kind="synchronisation" x="-180" y="-30">onRampEntered!</label>
			<label kind="assignment" x="-180" y="-10">e = 0, remainingLane = 200</label>
		</transition>
		<transition id="id37">
			<source ref="id32"/>
			<target ref="id33"/>
			<label kind="guard" x="70" y="-40">e &gt;= 3</label>
			<label kind="assignment" x="70" y="-20">safeGap = true, gapSeconds = 5</label>
		</transition>
		<transition id="id38">
			<source ref="id33"/>
			<target ref="id33"/>
			<label kind="synchronisation" x="315" y="-130">safeGapFound!</label>
			<nail x="285" y="-115"/>
			<nail x="285" y="-55"/>
		</transition>
		<transition id="id39">
			<source ref="id33"/>
			<target ref="id34"/>
			<label kind="synchronisation" x="250" y="25">gapClosedBelowThreshold!</label>
			<label kind="assignment" x="250" y="45">safeGap = false, gapSeconds = 1, e = 0</label>
		</transition>
		<transition id="id40">
			<source ref="id34"/>
			<target ref="id33"/>
			<label kind="synchronisation" x="70" y="145">nextBestGapFound!</label>
			<label kind="assignment" x="70" y="165">safeGap = true, gapSeconds = 5</label>
		</transition>
		<transition id="id41">
			<source ref="id32"/>
			<target ref="id32"/>
			<label kind="guard" x="-60" y="80">remainingLane &gt; 0</label>
			<label kind="assignment" x="-60" y="100">remainingLane = remainingLane - 10</label>
			<nail x="-30" y="-30"/>
			<nail x="30" y="-30"/>
		</transition>
		<transition id="id42">
			<source ref="id34"/>
			<target ref="id33"/>
			<label kind="guard" x="330" y="200">e &gt;= 5</label>
			<label kind="synchronisation" x="330" y="220">safeGapFound!</label>
			<label kind="assignment" x="330" y="240">safeGap = true, gapSeconds = 4, e = 0</label>
		</transition>
		<transition id="id43">
			<source ref="id33"/>
			<target ref="id33"/>
			<label kind="synchronisation" x="380" y="-70">nextBestGapFound!</label>
			<nail x="315" y="-115"/>
			<nail x="315" y="-55"/>
		</transition>
		<transition id="id44">
			<source ref="id33"/>
			<target ref="id33"/>
			<label kind="guard" x="340" y="-130">safeGap</label>
			<nail x="255" y="-115"/>
			<nail x="255" y="-55"/>
		</transition>
	</template>
	<template>
		<name>BrakeSystem</name>
		<location id="id45" x="-170" y="0">
			<name x="-200" y="-30">Ready</name>
		</location>
		<location id="id46" x="85" y="0">
			<name x="45" y="-30">Braking</name>
		</location>
		<init ref="id45"/>
		<transition id="id47">
			<source ref="id45"/>
			<target ref="id46"/>
			<label kind="synchronisation" x="-95" y="-30">brakeCmd?</label>
		</transition>
		<transition id="id48">
			<source ref="id46"/>
			<target ref="id45"/>
			<label kind="synchronisation" x="-85" y="35">hazardCleared!</label>
		</transition>
		<transition id="id49">
			<source ref="id45"/>
			<target ref="id46"/>
			<label kind="synchronisation" x="-115" y="75">collisionImminent?</label>
		</transition>
	</template>
	<template>
		<name>SteeringSystem</name>
		<location id="id50" x="-170" y="0">
			<name x="-200" y="-30">Straight</name>
		</location>
		<location id="id51" x="85" y="0">
			<name x="45" y="-30">Steering</name>
		</location>
		<init ref="id50"/>
		<transition id="id52">
			<source ref="id50"/>
			<target ref="id51"/>
			<label kind="synchronisation" x="-100" y="-30">planReady?</label>
		</transition>
		<transition id="id53">
			<source ref="id51"/>
			<target ref="id50"/>
			<label kind="synchronisation" x="-90" y="35">mergeCompleted?</label>
		</transition>
		<transition id="id54">
			<source ref="id51"/>
			<target ref="id51"/>
			<label kind="synchronisation" x="170" y="-30">planReady?</label>
			<nail x="115" y="-30"/>
			<nail x="115" y="-10"/>
		</transition>
	</template>
	<template>
		<name>PowerSystem</name>
		<location id="id55" x="-170" y="0">
			<name x="-205" y="-30">Standby</name>
		</location>
		<location id="id56" x="85" y="0">
			<name x="45" y="-30">Supplying</name>
		</location>
		<init ref="id55"/>
		<transition id="id57">
			<source ref="id55"/>
			<target ref="id56"/>
			<label kind="synchronisation" x="-110" y="-30">planReady?</label>
		</transition>
		<transition id="id58">
			<source ref="id56"/>
			<target ref="id55"/>
			<label kind="synchronisation" x="-90" y="35">mergeCompleted?</label>
		</transition>
		<transition id="id59">
			<source ref="id56"/>
			<target ref="id56"/>
			<label kind="synchronisation" x="170" y="-30">planReady?</label>
			<nail x="115" y="-30"/>
			<nail x="115" y="-10"/>
		</transition>
	</template>
	<system>AI = AI_Controller();
SEN = Sensors();
ENV = Environment();
BRK = BrakeSystem();
STR = SteeringSystem();
PWR = PowerSystem();

system AI, SEN, ENV, BRK, STR, PWR;</system>
	<queries>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>No deadlock should occur.</comment>
		</query>
		<query>
			<formula>E&lt;&gt; AI.MergeSuccess</formula>
			<comment>There exists a path where the robotaxi merges successfully.</comment>
		</query>
		<query>
			<formula>A[] AI.MergeExecution imply planComputed</formula>
			<comment>The vehicle should execute merge only after a plan is computed.</comment>
		</query>
		<query>
			<formula>A[] emergencyActive imply AI.EmergencyBraking</formula>
			<comment>Emergency flag should correspond to EmergencyBraking state.</comment>
		</query>
	</queries>
</nta>
